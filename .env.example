# GitHub personal access token (read repo/public_repo; write only if opening PRs from a fork).
# Never commit this file.
GITHUB_TOKEN=your_github_pat_here

# Root directory under which all per-issue workspaces are created.
# All file/git/sandbox operations are confined to this directory.
WORKSPACE_ROOT=./workspaces

# Streamable HTTP bind address (127.0.0.1 only -- never 0.0.0.0).
HOST=127.0.0.1
PORT=8765
PATH=/mcp

# Maximum number of diff lines allowed in a single commit (safety guardrail).
MAX_DIFF_LINES=500

# Timeouts (seconds).
CLONE_TIMEOUT_SECONDS=300
COMMAND_TIMEOUT_SECONDS=300

# Maximum bytes of command output returned to the host.
MAX_OUTPUT_BYTES=50000
